{% style %}
  #cwc_video-text-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#142C70' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --stat-track: {{ section.settings.stat_track_color | default: '#ECF4FF' }};
    --star-color: {{ section.settings.star_color | default: '#F7CD33' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E38A0A' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 100 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 100 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 100 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_video-text.css' | asset_url | stylesheet_tag }}

