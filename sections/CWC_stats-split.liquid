{% style %}
  #cwc_stats-split-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --ring-color: {{ section.settings.ring_color | default: '#142C70' }};
    --ring-track: {{ section.settings.ring_track_color | default: '#E3E8F5' }};
    --percent-color: {{ section.settings.percent_color | default: '#142C70' }};
    --border-color: {{ section.settings.border_color | default: '#E3E3E3' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_stats-split.css' | asset_url | stylesheet_tag }}

<section id="cwc_stats-split-{{ section.id }}" class="cwc_stats-split">
  <div class="cwc_stats-split__container">

    {% comment %} Heading column {% endcomment %}
    <div class="cwc_stats-split__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_stats-split__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_stats-split__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Stats column {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_stats-split__list">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'stat' %}
              {%- liquid
                # Ring radius is 20, so the full circumference is 2 * pi * 20.
                assign circumference = 125.66
                assign filled = block.settings.percent | times: 1.2566
                assign dash_offset = circumference | minus: filled
              -%}
              <div class="cwc_stats-split__item" {{ block.shopify_attributes }}>
                <div class="cwc_stats-split__ring">
                  <svg viewBox="0 0 48 48" width="48" height="48" aria-hidden="true">
                    <circle
                      class="cwc_stats-split__ring-track"
                      cx="24"
                      cy="24"
                      r="20"
                      fill="none"
                      stroke-width="4"
                    ></circle>
                    <circle
                      class="cwc_stats-split__ring-fill"
                      cx="24"
                      cy="24"
                      r="20"
                      fill="none"
                      stroke-width="4"
                      stroke-linecap="round"
                      stroke-dasharray="{{ circumference }}"
                      stroke-dashoffset="{{ dash_offset }}"
                    ></circle>
                  </svg>
                  <span class="cwc_stats-split__percent">{{ block.settings.percent }}%</span>
                </div>

                {% if block.settings.text != blank %}
                  <div class="cwc_stats-split__item-text cwc-rte">{{ block.settings.text }}</div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_stats-split__empty">
        <p>Add blocks to display content.</p>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Stats Split",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>What Pet Owners Notice After <strong>Switching to Waterless</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Ring Fill Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "ring_track_color",
      "label": "Ring Track Color",
      "default": "#E3E8F5"
    },
    {
      "type": "color",
      "id": "percent_color",
      "label": "Percentage Text Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider Color",
      "default": "#E3E3E3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "range",
          "id": "percent",
          "label": "Percentage",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 92
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add the supporting statement for this statistic here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CWC Stats Split",
      "category": "CWC Custom",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
