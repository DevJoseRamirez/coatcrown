{% style %}
  #cwc_footer-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#1E2C6B' }};
    --text-color: {{ section.settings.text_color | default: '#D5DAEC' }};
    --heading-color: {{ section.settings.heading_color | default: '#ffffff' }};
    --link-color: {{ section.settings.link_color | default: '#D5DAEC' }};
    --border-color: {{ section.settings.border_color | default: '#3B4886' }};
    --input-border: {{ section.settings.input_border_color | default: '#8E97C9' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#ffffff' }};
    --button-text: {{ section.settings.button_text_color | default: '#1E2C6B' }};
    --logo-width: {{ section.settings.logo_width | default: 160 }}px;
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 30 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 30 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_footer.css' | asset_url | stylesheet_tag }}

<section id="cwc_footer-{{ section.id }}" class="cwc_footer">
  <div class="cwc_footer__container">
    <div class="cwc_footer__columns">
      {% if section.settings.logo != blank %}
        <div class="cwc_footer__logo">
          <img
            src="{{ section.settings.logo | image_url: width: 400 }}"
            alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
            loading="lazy"
            width="200"
            height="60"
          >
        </div>
      {% endif %}

      {% for block in section.blocks %}
        <div class="cwc_footer__column" {{ block.shopify_attributes }}>
          {% if block.settings.heading != blank %}
            <p class="cwc_footer__column-heading">{{ block.settings.heading }}</p>
          {% endif %}

          {% case block.type %}
            {% when 'text_column' %}
              {% if block.settings.content != blank %}
                <div class="cwc_footer__text cwc-rte">{{ block.settings.content }}</div>
              {% endif %}

            {% when 'link_column' %}
              {% if block.settings.menu != blank %}
                <ul class="cwc_footer__links">
                  {% for link in block.settings.menu.links %}
                    <li>
                      <a href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}

            {% when 'newsletter_column' %}
              {% if block.settings.text != blank %}
                <div class="cwc_footer__text cwc-rte">{{ block.settings.text }}</div>
              {% endif %}

              {% comment %}
                On success the field and button are replaced by the confirmation
                rather than sitting under it, so the column keeps its shape and
                nobody is invited to sign up twice.
              {% endcomment %}
              {% form 'customer', class: 'cwc_footer__form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">

                {% if form.posted_successfully? %}
                  <p class="cwc_footer__form-note">{{ block.settings.success_text }}</p>
                {% else %}
                  <div class="cwc_footer__form-row">
                    <input
                      class="cwc_footer__input"
                      type="email"
                      name="contact[email]"
                      placeholder="{{ block.settings.placeholder | default: 'Email' | escape }}"
                      aria-label="{{ block.settings.placeholder | default: 'Email' | escape }}"
                      autocomplete="email"
                      required
                    >
                    <button class="cwc_footer__button" type="submit">{{ block.settings.button_label }}</button>
                  </div>

                  {% if form.errors %}
                    <p class="cwc_footer__form-error">
                      {{ form.errors.messages.form | default: form.errors.messages.email }}
                    </p>
                  {% endif %}
                {% endif %}
              {% endform %}
          {% endcase %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.disclaimer != blank %}
      <div class="cwc_footer__disclaimer cwc-rte">{{ section.settings.disclaimer }}</div>
    {% endif %}

    <div class="cwc_footer__bottom">
      <p class="cwc_footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          &copy; {{ 'now' | date: '%Y' }}
          {{ shop.name }}
        {% endif %}
      </p>

      {% comment %}
        A menu wins when the merchant sets one, otherwise the store's own
        published policies are listed — unpublished ones come through blank.
      {% endcomment %}
      {% if section.settings.policy_menu != blank %}
        <ul class="cwc_footer__policies">
          {% for link in section.settings.policy_menu.links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      {% elsif shop.policies.size > 0 %}
        <ul class="cwc_footer__policies">
          {% for policy in shop.policies %}
            {% if policy != blank %}
              <li>
                <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Footer",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Sits as the first column. Leave empty to start with the columns below."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 80,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "info": "Small print above the bottom bar, e.g. FDA statements."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "info": "Leave empty to show the year and your store name."
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy Menu",
      "info": "Optional. Leave empty to list your store's published policies automatically."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1E2C6B"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Column Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#D5DAEC"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#D5DAEC"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider Color",
      "default": "#3B4886"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Email Field Border Color",
      "default": "#8E97C9"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#1E2C6B"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "text_column",
      "name": "Text Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Get in touch:"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Column Text",
          "default": "<p><strong>Phone:</strong> (000) 000-0000<br/>Mon–Fri: 9am–9pm EST</p>"
        }
      ]
    },
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Shop & Support"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "newsletter_column",
      "name": "Newsletter Column",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Heading",
          "default": "Become a VIP"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Column Text",
          "default": "<p>Join now and get 15% off your first order, plus first dibs on sales and new products.</p>"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Email Field Placeholder",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Join Now →"
        },
        {
          "type": "text",
          "id": "success_text",
          "label": "Success Message",
          "default": "Thanks for subscribing."
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "presets": [
    {
      "name": "CWC Footer",
      "category": "CWC Custom",
      "blocks": [{ "type": "text_column" }, { "type": "link_column" }, { "type": "newsletter_column" }]
    }
  ]
}
{% endschema %}
