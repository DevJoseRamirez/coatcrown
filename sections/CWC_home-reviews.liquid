      "label": "Background Color",
      "default": "#ECF4FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Quote Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1F3D6E"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#1F3D6E"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#FBBF24"
    },
    {
      "type": "color",
      "id": "nav_color",
