{% style %}
  #cwc_hero-product-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ECF4FF' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#142C70' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --star-color: {{ section.settings.star_color | default: '#F7CD33' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E38A0A' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 64 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 64 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 64 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_hero-product.css' | asset_url | stylesheet_tag }}

{%- capture star_svg -%}
  <svg class="cwc_hero-product__star" xmlns="http://www.w3.org/2000/svg" width="15" height="14" viewBox="0 0 15 14" fill="currentColor" aria-hidden="true">
    <path d="M7.49963 11.7285L3.86408 13.8687C3.70347 13.9686 3.53557 14.0114 3.36036 13.9971C3.18515 13.9829 3.03185 13.9258 2.90044 13.8259C2.76904 13.726 2.66683 13.6013 2.59383 13.4518C2.52083 13.3023 2.50623 13.1345 2.55003 12.9484L3.51367 8.90338L0.294239 6.18528C0.148233 6.05686 0.0571255 5.91047 0.020916 5.7461C-0.0152934 5.58173 -0.00448903 5.42136 0.0533293 5.26498C0.111148 5.1086 0.198751 4.98018 0.31614 4.87974C0.433528 4.77929 0.594135 4.71508 0.797959 4.68711L5.04673 4.32327L6.68929 0.513656C6.7623 0.342438 6.8756 0.214023 7.0292 0.128414C7.18279 0.0428046 7.3396 0 7.49963 0C7.65965 0 7.81646 0.0428046 7.97006 0.128414C8.12366 0.214023 8.23696 0.342438 8.30996 0.513656L9.95253 4.32327L14.2013 4.68711C14.4057 4.71565 14.5663 4.77986 14.6831 4.87974C14.7999 4.97961 14.8875 5.10803 14.9459 5.26498C15.0043 5.42193 15.0154 5.58259 14.9792 5.74696C14.943 5.91133 14.8516 6.05744 14.705 6.18528L11.4856 8.90338L12.4492 12.9484C12.493 13.1339 12.4784 13.3017 12.4054 13.4518C12.3324 13.6019 12.2302 13.7266 12.0988 13.8259C11.9674 13.9252 11.8141 13.9823 11.6389 13.9971C11.4637 14.012 11.2958 13.9692 11.1352 13.8687L7.49963 11.7285Z"/>
  </svg>
{%- endcapture -%}

<section id="cwc_hero-product-{{ section.id }}" class="cwc_hero-product">
  <div class="cwc_hero-product__container">
    {% comment %} Product Image {% endcomment %}
    <div class="cwc_hero-product__image">
      {% if section.settings.product_image != blank %}
        <img
          src="{{ section.settings.product_image | image_url: width: 900 }}"
          alt="{{ section.settings.alt_text | default: section.settings.product_image.alt | default: 'Product image' | escape }}"
          loading="lazy"
          width="900"
          height="900"
        >
      {% else %}
        <div class="cwc_hero-product__placeholder"><span>Add product image</span></div>
      {% endif %}
    </div>

    {% comment %} Content {% endcomment %}
    <div class="cwc_hero-product__content">
      {% if section.settings.rating_stars > 0 or section.settings.rating_text != blank %}
        <div class="cwc_hero-product__rating">
          {% if section.settings.rating_stars > 0 %}
            <div class="cwc_hero-product__stars">
              {% render 'CWC_stars_block' %}
            </div>
          {% endif %}
          {% if section.settings.rating_text != blank %}
            <div class="cwc_hero-product__rating-text cwc-rte">{{ section.settings.rating_text }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_hero-product__heading cwc-rte">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_hero-product__subheading cwc-rte">{{ section.settings.subtext }}</div>
      {% endif %}

      {% if section.settings.usp_1 != blank or section.settings.usp_2 != blank or section.settings.usp_3 != blank %}
        <div class="cwc_hero-product__points">
          {% for i in (1..3) %}
            {% assign usp_key = 'usp_' | append: i %}
            {% assign usp_value = section.settings[usp_key] %}
            {% if usp_value != blank %}
              <div class="cwc_hero-product__point">
                <svg
                  class="cwc_hero-product__check"
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 28 28"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M12.3654 19.3668L20.5904 11.1418L18.957 9.5085L12.3654 16.1002L9.04036 12.7752L7.40703 14.4085L12.3654 19.3668ZM13.9987 25.6668C12.3848 25.6668 10.8681 25.3606 9.4487 24.7481C8.02925 24.1356 6.79453 23.3043 5.74453 22.2543C4.69453 21.2043 3.86328 19.9696 3.25078 18.5502C2.63828 17.1307 2.33203 15.6141 2.33203 14.0002C2.33203 12.3863 2.63828 10.8696 3.25078 9.45016C3.86328 8.03072 4.69453 6.796 5.74453 5.746C6.79453 4.696 8.02925 3.86475 9.4487 3.25225C10.8681 2.63975 12.3848 2.3335 13.9987 2.3335C15.6126 2.3335 17.1293 2.63975 18.5487 3.25225C19.9681 3.86475 21.2029 4.696 22.2529 5.746C23.3029 6.796 24.1341 8.03072 24.7466 9.45016C25.3591 10.8696 25.6654 12.3863 25.6654 14.0002C25.6654 15.6141 25.3591 17.1307 24.7466 18.5502C24.1341 19.9696 23.3029 21.2043 22.2529 22.2543C21.2029 23.3043 19.9681 24.1356 18.5487 24.7481C17.1293 25.3606 15.6126 25.6668 13.9987 25.6668Z"/>
                </svg>
                <div class="cwc_hero-product__point-text cwc-rte">{{ usp_value }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="cwc_hero-product__button-wrapper">
          <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_hero-product__button">
            <span>{{ section.settings.button_label }}</span>
            <svg
              class="cwc_hero-product__button-arrow"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path d="M1 8L15 8M15 8L8.38889 1M15 8L8.38889 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      {% endif %}

      {% if section.settings.testimonial_quote != blank
        or section.settings.testimonial_author != blank
        or section.settings.testimonial_image != blank
      %}
        <div class="cwc_hero-product__testimonial">
          {% if section.settings.testimonial_image != blank %}
            <img
              class="cwc_hero-product__testimonial-img"
              src="{{ section.settings.testimonial_image | image_url: width: 192 }}"
              alt="{{ section.settings.testimonial_author | default: 'Customer' | escape }}"
              loading="lazy"
              width="96"
              height="96"
            >
          {% endif %}

          <div class="cwc_hero-product__testimonial-content">
            {% if section.settings.testimonial_quote != blank %}
              <div class="cwc_hero-product__quote cwc-rte">{{ section.settings.testimonial_quote }}</div>
            {% endif %}

            <div class="cwc_hero-product__testimonial-meta">
              {% if section.settings.testimonial_stars > 0 %}
                <div class="cwc_hero-product__t-stars">
                  {% render 'CWC_stars_block' %}
                </div>
              {% endif %}
              {% if section.settings.testimonial_author != blank %}
                <span class="cwc_hero-product__testimonial-author">{{ section.settings.testimonial_author }}</span>
              {% endif %}
              {% if section.settings.testimonial_verified_text != blank %}
                <span class="cwc_hero-product__verified-badge">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M6.69773 15.3319C7.58522 16.2262 8.4093 16.2192 9.29709 15.3319L10.3817 14.254C10.4944 14.1485 10.593 14.1061 10.7409 14.1061H12.2625C13.5233 14.1061 14.1078 13.5286 14.1078 12.261V10.7396C14.1078 10.5917 14.1502 10.4932 14.2557 10.3805L15.3265 9.29567C16.2281 8.40829 16.2209 7.58431 15.3265 6.69693L14.2557 5.61211C14.1502 5.50694 14.1078 5.40116 14.1078 5.26022V3.73187C14.1078 2.47817 13.5302 1.88678 12.2625 1.88678H10.7409C10.593 1.88678 10.4944 1.85132 10.3817 1.74555L9.29679 0.668245C8.4093 -0.226351 7.58522 -0.219139 6.69773 0.668245L5.61279 1.74585C5.5076 1.85132 5.40181 1.88648 5.26085 1.88648H3.73232C2.47156 1.88648 1.88701 2.46405 1.88701 3.73157V5.26022C1.88701 5.40116 1.85155 5.50664 1.74576 5.61241L0.668325 6.69723C-0.226378 7.58431 -0.219165 8.40829 0.668325 9.29597L1.74606 10.3805C1.85155 10.4932 1.88671 10.5917 1.88671 10.7396V12.261C1.88671 13.5216 2.47156 14.1061 3.73201 14.1061H5.26085C5.40181 14.1061 5.5073 14.1485 5.61309 14.254L6.69773 15.3319ZM6.81043 11.5425C6.59224 11.5425 6.45129 11.4722 6.3455 11.3523L3.99288 8.73944C3.89423 8.62886 3.83922 8.48615 3.8381 8.33797C3.8381 8.00682 4.09146 7.76041 4.4509 7.76041C4.64084 7.76041 4.7818 7.82381 4.90862 7.95754L6.77497 10.0214L10.4028 4.91495C10.5437 4.71061 10.6847 4.62646 10.9311 4.62646C11.2761 4.62646 11.5229 4.87979 11.5229 5.21094C11.5229 5.33054 11.4736 5.47148 11.396 5.58417L7.28949 11.3244C7.1837 11.4581 7.02201 11.5425 6.81043 11.5425Z"/>
                  </svg>
                  {{ section.settings.testimonial_verified_text }}
                </span>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Hero Product",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Rating Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "<p><strong>4.8/5</strong> from <strong>45,000+</strong> satisfied customers</p>"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Treat Your Four-Legged Pal To The <strong>Ultimate Spa Day</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Show your pet how much you care by turning grooming into bonding. Plus, look after your wallet with up to 25% off.</p>"
    },
    {
      "type": "richtext",
      "id": "usp_1",
      "label": "Bullet 1",
      "default": "<p><strong>Less shedding</strong> instantly, more relaxed pets</p>"
    },
    {
      "type": "richtext",
      "id": "usp_2",
      "label": "Bullet 2",
      "default": "<p><strong>Smooth grooming</strong> every time with less mess</p>"
    },
    {
      "type": "richtext",
      "id": "usp_3",
      "label": "Bullet 3",
      "default": "<p><strong>Softer, shinier coats</strong> after just a week</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Testimonial"
    },
    {
      "type": "image_picker",
      "id": "testimonial_image",
      "label": "Customer Photo"
    },
    {
      "type": "richtext",
      "id": "testimonial_quote",
      "label": "Quote",
      "default": "<p>\"I never thought grooming could be enjoyable for my anxious terrier, but the ReNu brush is a game-changer! It's gentle, effective, and Lola loves it!\"</p>"
    },
    {
      "type": "text",
      "id": "testimonial_author",
      "label": "Author Name",
      "default": "Linda S"
    },
    {
      "type": "range",
      "id": "testimonial_stars",
      "label": "Testimonial Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "text",
      "id": "testimonial_verified_text",
      "label": "Verified Badge Text",
      "default": "Verified Customer"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ECF4FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Accent Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F7CD33"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Testimonial Card Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#E38A0A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "CWC Hero Product",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
