{% style %}
  #cwc_trust-bar-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#142c70' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --font-size: {{ section.settings.font_size | default: 16 }}px;
    --font-size-mobile: {{ section.settings.font_size | default: 16 | times: 0.9375 }}px;
    --padding-top: {{ section.settings.padding_top | default: 12 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 12 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 12 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 12 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_trust-bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign separator_character = section.settings.separator_character | strip
  assign show_separator = false
  if section.settings.show_separator and separator_character != blank
    assign show_separator = true
  endif

  assign scroll_classes = ''
  if section.settings.autoscroll_desktop
    assign scroll_classes = scroll_classes | append: ' cwc_trust-bar--autoscroll-desktop'
  endif
  if section.settings.autoscroll_mobile
    assign scroll_classes = scroll_classes | append: ' cwc_trust-bar--autoscroll-mobile'
  endif
-%}

<section id="cwc_trust-bar-{{ section.id }}" class="cwc_trust-bar{{ scroll_classes }}">
  <div class="cwc_trust-bar__container">
    <div class="cwc_trust-bar__marquee">
      <div class="cwc_trust-bar__group">
        {% for block in section.blocks %}
          <div class="cwc_trust-bar__item" {{ block.shopify_attributes }}>
            {% if block.settings.trust_icon != blank %}
              <div class="cwc_trust-bar__icon">
                <img
                  src="{{ block.settings.trust_icon | image_url: width: 48 }}"
                  alt="{{ block.settings.trust_icon.alt | default: block.settings.text | escape }}"
                  loading="lazy"
                  width="24"
                  height="24"
                >
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="cwc_trust-bar__text">{{ block.settings.text }}</span>
            {% endif %}
          </div>
          {% comment %} Rendered after every item — including the last — so the loop seam gets one too {% endcomment %}
          {% if show_separator %}
            <span class="cwc_trust-bar__separator" aria-hidden="true">{{ separator_character }}</span>
          {% endif %}
        {% endfor %}
      </div>

      {% comment %} Duplicate group for the seamless marquee loop — hidden at any
      breakpoint where auto-scroll is off {% endcomment %}
      <div class="cwc_trust-bar__group cwc_trust-bar__group--duplicate" aria-hidden="true">
        {% for block in section.blocks %}
          <div class="cwc_trust-bar__item">
            {% if block.settings.trust_icon != blank %}
              <div class="cwc_trust-bar__icon">
                <img
                  src="{{ block.settings.trust_icon | image_url: width: 48 }}"
                  alt=""
                  loading="lazy"
                  width="24"
                  height="24"
                >
              </div>
            {% endif %}
            {% if block.settings.text != blank %}
              <span class="cwc_trust-bar__text">{{ block.settings.text }}</span>
            {% endif %}
          </div>
          {% if show_separator %}
            <span class="cwc_trust-bar__separator">{{ separator_character }}</span>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Trust Bar",
  "settings": [
    {
      "type": "header",
      "content": "Auto Scroll"
    },
    {
      "type": "checkbox",
      "id": "autoscroll_desktop",
      "label": "Auto Scroll On Desktop",
      "info": "Off shows a static bar with the items spread evenly across the row.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoscroll_mobile",
      "label": "Auto Scroll On Mobile",
      "info": "Applies at 768px and below. Recommended on — a static bar wraps onto several lines when the items do not fit.",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#142c70"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text Font Size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 16,
      "info": "Mobile scales to ~94% of this value."
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "checkbox",
      "id": "show_separator",
      "label": "Show Separator Between Items",
      "default": false
    },
    {
      "type": "text",
      "id": "separator_character",
      "label": "Separator Character",
      "default": "✦",
      "info": "Only shown when the separator is turned on."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "trust_icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust point"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CWC Trust Bar",
      "category": "CWC Custom",
      "blocks": [
        { "type": "trust_item", "settings": { "text": "Free Shipping On Orders Above $55" } },
        { "type": "trust_item", "settings": { "text": "Safe & Secure Checkout" } },
        { "type": "trust_item", "settings": { "text": "365 Day Money Back Guarantee" } },
        { "type": "trust_item", "settings": { "text": "Loved By 45,576+ Pet Parents" } }
      ]
    }
  ]
}
{% endschema %}
