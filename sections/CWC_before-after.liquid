{% style %}
  #cwc_before-after-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --star-color: {{ section.settings.star_color | default: '#142C70' }};
    --accent-color: {{ section.settings.accent_color | default: '#142C70' }};
    --label-color: {{ section.settings.label_color | default: '#111111' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_before-after.css' | asset_url | stylesheet_tag }}

{%- capture star_icon -%}
  <svg class="cwc_before-after__star" xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 15 14" fill="currentColor" aria-hidden="true">
    <path d="M7.49963 11.7285L3.86408 13.8687C3.70347 13.9686 3.53557 14.0114 3.36036 13.9971C3.18515 13.9829 3.03185 13.9258 2.90044 13.8259C2.76904 13.726 2.66683 13.6013 2.59383 13.4518C2.52083 13.3023 2.50623 13.1345 2.55003 12.9484L3.51367 8.90338L0.294239 6.18528C0.148233 6.05686 0.0571255 5.91047 0.020916 5.7461C-0.0152934 5.58173 -0.00448903 5.42136 0.0533293 5.26498C0.111148 5.1086 0.198751 4.98018 0.31614 4.87974C0.433528 4.77929 0.594135 4.71508 0.797959 4.68711L5.04673 4.32327L6.68929 0.513656C6.7623 0.342438 6.8756 0.214023 7.0292 0.128414C7.18279 0.0428046 7.3396 0 7.49963 0C7.65965 0 7.81646 0.0428046 7.97006 0.128414C8.12366 0.214023 8.23696 0.342438 8.30996 0.513656L9.95253 4.32327L14.2013 4.68711C14.4057 4.71565 14.5663 4.77986 14.6831 4.87974C14.7999 4.97961 14.8875 5.10803 14.9459 5.26498C15.0043 5.42193 15.0154 5.58259 14.9792 5.74696C14.943 5.91133 14.8516 6.05744 14.705 6.18528L11.4856 8.90338L12.4492 12.9484C12.493 13.1339 12.4784 13.3017 12.4054 13.4518C12.3324 13.6019 12.2302 13.7266 12.0988 13.8259C11.9674 13.9252 11.8141 13.9823 11.6389 13.9971C11.4637 14.012 11.2958 13.9692 11.1352 13.8687L7.49963 11.7285Z"/>
  </svg>
{%- endcapture -%}

<section id="cwc_before-after-{{ section.id }}" class="cwc_before-after">
  <div class="cwc_before-after__container">

    {% comment %} Section Header {% endcomment %}
    {% if section.settings.heading != blank or section.settings.subtext != blank %}
      <div class="cwc_before-after__content">
        {% if section.settings.heading != blank %}
          <div class="cwc_before-after__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_before-after__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% comment %}
      Only the two inner tracks move. The controls sit outside both of them so
      the arrows and counter never travel with the content.
    {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_before-after__layout">

        {% comment %} Media track {% endcomment %}
        <div class="cwc_before-after__viewport cwc_before-after__viewport--media">
          <div class="cwc_before-after__track cwc_before-after__track--media" data-cwc-track="media">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'pair' %}
                  <div
                    class="cwc_before-after__media{% if forloop.first %} is-active{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="cwc_before-after__figure cwc_before-after__figure--before">
                      {% if block.settings.image_before != blank %}
                        <img
                          src="{{ block.settings.image_before | image_url: width: 700 }}"
                          alt="{{ block.settings.image_before.alt | default: block.settings.label_before | escape }}"
                          loading="lazy"
                          width="350"
                          height="450"
                        >
                      {% else %}
                        <span class="cwc_before-after__empty">Before image</span>
                      {% endif %}
                    </div>

                    {% if block.settings.label_before != blank %}
                      <span class="cwc_before-after__label cwc_before-after__label--before">
                        <svg xmlns="http://www.w3.org/2000/svg" width="70" height="30" viewBox="0 0 70 30" fill="none" aria-hidden="true">
                          <path d="M68 26C52 30 30 24 12 10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                          <path d="M12 10L22 12M12 10L15 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                        <span>{{ block.settings.label_before }}</span>
                      </span>
                    {% endif %}

                    <div class="cwc_before-after__figure cwc_before-after__figure--after">
                      {% if block.settings.image_after != blank %}
                        <img
                          src="{{ block.settings.image_after | image_url: width: 700 }}"
                          alt="{{ block.settings.image_after.alt | default: block.settings.label_after | escape }}"
                          loading="lazy"
                          width="350"
                          height="450"
                        >
                      {% else %}
                        <span class="cwc_before-after__empty">After image</span>
                      {% endif %}
                    </div>

                    {% if block.settings.label_after != blank %}
                      <span class="cwc_before-after__label cwc_before-after__label--after">
                        <span>{{ block.settings.label_after }}</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="70" height="30" viewBox="0 0 70 30" fill="none" aria-hidden="true">
                          <path d="M2 6C18 2 40 8 58 22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                          <path d="M58 22L48 20M58 22L55 12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                    {% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        </div>

        {% comment %} Testimonial track + static controls {% endcomment %}
        <div class="cwc_before-after__aside">
          <div class="cwc_before-after__viewport cwc_before-after__viewport--text">
            <div class="cwc_before-after__track cwc_before-after__track--text" data-cwc-track="text">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'pair' %}
                    <div class="cwc_before-after__testimonial">
                      {% if block.settings.stars > 0 %}
                        <div class="cwc_before-after__stars">
                          {% for i in (1..block.settings.stars) %}
                            {{ star_icon }}
                          {% endfor %}
                        </div>
                      {% endif %}

                      {% if block.settings.quote != blank %}
                        <div class="cwc_before-after__quote cwc-rte">{{ block.settings.quote }}</div>
                      {% endif %}

                      {% if block.settings.author != blank %}
                        <p class="cwc_before-after__author">{{ block.settings.author }}</p>
                      {% endif %}
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          </div>

          <div class="cwc_before-after__controls">
            <button
              class="cwc_before-after__arrow"
              type="button"
              data-cwc-prev
              aria-label="Previous testimonial"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="46" height="12" viewBox="0 0 46 12" fill="none" aria-hidden="true">
                <path d="M45 6H2M2 6L7 1M2 6L7 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>

            <span class="cwc_before-after__counter" data-cwc-counter>1 / {{ section.blocks.size }}</span>

            <button
              class="cwc_before-after__arrow"
              type="button"
              data-cwc-next
              aria-label="Next testimonial"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="46" height="12" viewBox="0 0 46 12" fill="none" aria-hidden="true">
                <path d="M1 6H44M44 6L39 1M44 6L39 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>

      </div>
    {% else %}
      <div class="cwc_before-after__empty-state">
        <p>Add blocks to display content.</p>
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_before-after.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC Before After",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Arrow & Annotation Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Annotation Text Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "pair",
      "name": "Content Pair",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_before",
          "label": "Before Image"
        },
        {
          "type": "text",
          "id": "label_before",
          "label": "Before Label",
          "default": "from this"
        },
        {
          "type": "image_picker",
          "id": "image_after",
          "label": "After Image"
        },
        {
          "type": "text",
          "id": "label_after",
          "label": "After Label",
          "default": "to this"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to hide."
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Testimonial Quote",
          "default": "<p>\"Add the customer quote for this before and after pair here.\"</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "– Customer Name, Title"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CWC Before After",
      "category": "CWC Custom",
      "blocks": [
        { "type": "pair" },
        { "type": "pair" },
        { "type": "pair" }
      ]
    }
  ]
}
{% endschema %}
