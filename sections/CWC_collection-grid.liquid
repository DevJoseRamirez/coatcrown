{% style %}
  #cwc_collection-grid-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#1F3D6E' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --accent-color: {{ section.settings.accent_color | default: '#1F3D6E' }};
    --badge-color: {{ section.settings.badge_color | default: '#1D1D1D' }};
    --star-color: {{ section.settings.star_color | default: '#F7CD33' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_collection-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign grid_collection = section.settings.collection | default: collection
  assign section_heading = section.settings.heading | default: grid_collection.title
-%}

<section id="cwc_collection-grid-{{ section.id }}" class="cwc_collection-grid">
  <div class="cwc_collection-grid__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_collection-grid__content">
      {% if section_heading != blank %}
        <div class="cwc_collection-grid__content-heading cwc-rte">
          {{ section_heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_collection-grid__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}

      {% if section.settings.top_rating_stars > 0 or section.settings.top_rating_text != blank %}
        <div class="cwc_collection-grid__top-rating">
          {% if section.settings.top_rating_stars > 0 %}
            <span class="cwc_collection-grid__top-stars">
              {% render 'CWC_stars_block', fill_color: section.settings.star_color %}
            </span>
          {% endif %}

          {% if section.settings.top_rating_text != blank %}
            <div class="cwc_collection-grid__top-rating-text cwc-rte">
              {{ section.settings.top_rating_text }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% comment %} Products — grid on desktop, scroll-snap carousel on mobile {% endcomment %}
    {% if grid_collection.products.size > 0 %}
      <div class="cwc_collection-grid__track" data-cwc-track>
        {% for card_product in grid_collection.products limit: section.settings.products_limit %}
          {% liquid
            assign card_image = card_product.featured_image
            assign card_variant = card_product.selected_or_first_available_variant
            assign final_price = card_product.price
            assign compare_price = card_product.compare_at_price

            assign review_text = section.settings.default_review_text
            if card_product.metafields.reviews.rating_count != blank
              assign review_text = card_product.metafields.reviews.rating_count | append: ' reviews'
            endif
          %}

          <div class="cwc_collection-grid__card">

            {% comment %} Image {% endcomment %}
            <a href="{{ card_product.url }}" class="cwc_collection-grid__card-image">
              {% if card_image != blank %}
                <img
                  class="cwc_collection-grid__card-img"
                  src="{{ card_image | image_url: width: 600 }}"
                  alt="{{ card_image.alt | default: card_product.title | escape }}"
                  loading="lazy"
                  width="413"
                  height="413"
                >
              {% else %}
                <div class="cwc_collection-grid__placeholder">
                  <span>No image</span>
                </div>
              {% endif %}
            </a>

            {% comment %} Content {% endcomment %}
            <div class="cwc_collection-grid__card-content">

              <div class="cwc_collection-grid__card-title">
                <a href="{{ card_product.url }}">{{ card_product.title }}</a>
              </div>

              <div class="cwc_collection-grid__card-reviews">
                <span class="cwc_collection-grid__stars">
                  {% render 'CWC_stars_block', fill_color: section.settings.star_color %}
                </span>

                {% if review_text != blank %}
                  <span class="cwc_collection-grid__review-count">{{ review_text }}</span>
                {% endif %}

                {% if compare_price > final_price %}
                  <span class="cwc_collection-grid__badge-save">
                    SAVE {{ compare_price | minus: final_price | money_without_trailing_zeros }}
                  </span>
                {% endif %}
              </div>

              <div class="cwc_collection-grid__card-price">
                <span class="cwc_collection-grid__price-final">
                  {%- if card_product.price_varies %}From {% endif -%}
                  {{- final_price | money -}}
                </span>

                {% if compare_price > final_price %}
                  <span class="cwc_collection-grid__price-compare">{{ compare_price | money }}</span>
                {% endif %}
              </div>

              {% comment %} Native add-to-cart — triggers the theme cart drawer {% endcomment %}
              {% assign form_id = 'CWC-CollectionGrid-' | append: section.id | append: '-' | append: card_product.id %}
              <product-form-component
                data-section-id="{{ section.id }}"
                data-product-id="{{ card_product.id }}"
                on:submit="/handleSubmit"
                class="cwc_collection-grid__form"
              >
                <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                {%- form 'product', card_product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ card_variant.id }}"
                    {% if card_variant.available == false %}disabled{% endif %}
                  >
                  <input
                    type="hidden"
                    name="quantity"
                    value="{% if card_variant.quantity_rule.min %}{{ card_variant.quantity_rule.min }}{% else %}1{% endif %}"
                  >
                  {% render 'add-to-cart-button',
                    add_to_cart_text: 'Add to Cart',
                    class: 'cwc_collection-grid__atc',
                    can_add_to_cart: card_variant.available,
                    product: card_product
                  %}
                {%- endform -%}
              </product-form-component>

            </div>
          </div>
        {% endfor %}
      </div>

      {% comment %} Carousel arrows — mobile only, enhancement over native scroll {% endcomment %}
      <div class="cwc_collection-grid__nav">
        <button
          type="button"
          class="cwc_collection-grid__nav-btn cwc_collection-grid__nav-btn--prev"
          data-cwc-prev
          aria-label="Previous"
        >
          <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M14.5 7.375L1 7.375M1 7.375L7.375 1M1 7.375L7.375 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button
          type="button"
          class="cwc_collection-grid__nav-btn cwc_collection-grid__nav-btn--next"
          data-cwc-next
          aria-label="Next"
        >
          <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M1 7.375L14.5 7.375M14.5 7.375L8.125 1M14.5 7.375L8.125 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_collection-grid.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC Collection Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Join over 15,000+ happy owners upgrading their grooming routine.</p>"
    },
    {
      "type": "range",
      "id": "top_rating_stars",
      "label": "Top Rating Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "richtext",
      "id": "top_rating_text",
      "label": "Top Rating Text",
      "default": "<p>4.8/5 from thousands of satisfied customers</p>"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Override",
      "info": "Leave blank to use the collection this page is showing."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products Shown",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "default_review_text",
      "label": "Default Review Text",
      "default": "412 reviews",
      "info": "Overridden per product by the reviews.rating_count metafield when it exists."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1F3D6E"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "info": "Price, Add to Cart button, and carousel arrows.",
      "default": "#1F3D6E"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Save Badge Color",
      "default": "#1D1D1D"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F7CD33"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "CWC Collection Grid",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
