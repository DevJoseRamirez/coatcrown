{%- liquid
  assign mobile_columns = section.settings.mobile_columns | default: 2

  case mobile_columns
    when 1
      assign mobile_icon_size = '72px'
      assign mobile_icon_img_scale = '62%'
      assign mobile_text_size = '1rem'
      assign mobile_gap = '24px'
    when 3
      assign mobile_icon_size = '52px'
      assign mobile_icon_img_scale = '58%'
      assign mobile_text_size = '0.9375rem'
      assign mobile_gap = '16px'
    when 4
      assign mobile_icon_size = '44px'
      assign mobile_icon_img_scale = '56%'
      assign mobile_text_size = '0.875rem'
      assign mobile_gap = '12px'
    else
      assign mobile_icon_size = '64px'
      assign mobile_icon_img_scale = '60%'
      assign mobile_text_size = '1rem'
      assign mobile_gap = '24px'
  endcase
-%}

{% style %}
  #cwc_usp-bar-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ECF4FF' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --padding-top: {{ section.settings.padding_top | default: 20 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 20 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 20 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 20 | times: 0.5 }}px;
    --desktop-icon-img-scale: 60%;
    --mobile-columns: {{ mobile_columns }};
    --mobile-gap: {{ mobile_gap }};
    --mobile-icon-size: {{ mobile_icon_size }};
    --mobile-icon-img-scale: {{ mobile_icon_img_scale }};
    --mobile-text-size: {{ mobile_text_size }};
  }
{% endstyle %}

{{ 'CWC_usp-bar.css' | asset_url | stylesheet_tag }}

<section id="cwc_usp-bar-{{ section.id }}" class="cwc_usp-bar">
  <div class="cwc_usp-bar__container">
    {% for block in section.blocks %}
      <div class="cwc_usp-bar__item" {{ block.shopify_attributes }}>
        {% if block.settings.usp_icon != blank %}
          <div class="cwc_usp-bar__icon">
            <img
              src="{{ block.settings.usp_icon | image_url: width: 84 }}"
              alt="{{ block.settings.usp_icon.alt | default: block.settings.text | escape }}"
              loading="lazy"
              width="100"
              height="100"
            >
          </div>
        {% endif %}
        {% if block.settings.text != blank %}
          <span class="cwc_usp-bar__text">{{ block.settings.text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "CWC USP Bar",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ECF4FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Columns Per Row (Mobile)",
      "info": "Applies on screens 768px and below. Icon and text sizes scale down automatically at 3 and 4 columns.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "usp_item",
      "name": "USP Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "usp_icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Benefit"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CWC USP Bar",
      "category": "CWC Custom",
      "blocks": [
        { "type": "usp_item", "settings": { "text": "Stress-Free for Everyone" } },
        { "type": "usp_item", "settings": { "text": "Vet Verified" } },
        { "type": "usp_item", "settings": { "text": "Instant Relief" } },
        { "type": "usp_item", "settings": { "text": "Safe for All Pets" } },
        { "type": "usp_item", "settings": { "text": "Made For Dogs Of All Coat Types" } },
        { "type": "usp_item", "settings": { "text": "Thoughtfully Designed" } }
      ]
    }
  ]
}
{% endschema %}
