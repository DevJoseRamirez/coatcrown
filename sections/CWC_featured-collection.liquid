{% style %}
  #cwc_featured-collection-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#1F3D6E' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#EAF6FF' }};
    --accent-color: {{ section.settings.accent_color | default: '#142C70' }};
    --badge-bg: {{ section.settings.badge_color | default: '#E38A0A' }};
    --star-color: {{ section.settings.star_color | default: '#F7CD33' }};
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 60 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 60 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_featured-collection.css' | asset_url | stylesheet_tag }}

{%- capture star_svg -%}
  <svg class="cwc_featured-collection__star" xmlns="http://www.w3.org/2000/svg" width="15" height="14" viewBox="0 0 15 14" fill="currentColor" aria-hidden="true">
    <path d="M7.49963 11.7285L3.86408 13.8687C3.70347 13.9686 3.53557 14.0114 3.36036 13.9971C3.18515 13.9829 3.03185 13.9258 2.90044 13.8259C2.76904 13.726 2.66683 13.6013 2.59383 13.4518C2.52083 13.3023 2.50623 13.1345 2.55003 12.9484L3.51367 8.90338L0.294239 6.18528C0.148233 6.05686 0.0571255 5.91047 0.020916 5.7461C-0.0152934 5.58173 -0.00448903 5.42136 0.0533293 5.26498C0.111148 5.1086 0.198751 4.98018 0.31614 4.87974C0.433528 4.77929 0.594135 4.71508 0.797959 4.68711L5.04673 4.32327L6.68929 0.513656C6.7623 0.342438 6.8756 0.214023 7.0292 0.128414C7.18279 0.0428046 7.3396 0 7.49963 0C7.65965 0 7.81646 0.0428046 7.97006 0.128414C8.12366 0.214023 8.23696 0.342438 8.30996 0.513656L9.95253 4.32327L14.2013 4.68711C14.4057 4.71565 14.5663 4.77986 14.6831 4.87974C14.7999 4.97961 14.8875 5.10803 14.9459 5.26498C15.0043 5.42193 15.0154 5.58259 14.9792 5.74696C14.943 5.91133 14.8516 6.05744 14.705 6.18528L11.4856 8.90338L12.4492 12.9484C12.493 13.1339 12.4784 13.3017 12.4054 13.4518C12.3324 13.6019 12.2302 13.7266 12.0988 13.8259C11.9674 13.9252 11.8141 13.9823 11.6389 13.9971C11.4637 14.012 11.2958 13.9692 11.1352 13.8687L7.49963 11.7285Z"/>
  </svg>
{%- endcapture -%}

<section id="cwc_featured-collection-{{ section.id }}" class="cwc_featured-collection">

  {% comment %} Section Header {% endcomment %}
  <div class="cwc_featured-collection__content">
    {% if section.settings.heading != blank %}
      <div class="cwc_featured-collection__content-heading cwc-rte">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <div class="cwc_featured-collection__content-subtext cwc-rte">
        {{ section.settings.subtext }}
      </div>
    {% endif %}
  </div>

  {% comment %} Carousel {% endcomment %}
  {% if section.blocks.size > 0 %}
    <div class="cwc_featured-collection__slider-wrapper">

      <button
        type="button"
        class="cwc_featured-collection__nav-btn cwc_featured-collection__nav-btn--prev"
        data-cwc-prev
        aria-label="Previous"
      >
        <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M14.5 7.375L1 7.375M1 7.375L7.375 1M1 7.375L7.375 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <div class="cwc_featured-collection__track" data-cwc-track>
        {% for block in section.blocks %}
          {% assign card_product = block.settings.product %}

          {% liquid
            if block.settings.image != blank
              assign card_image = block.settings.image
            elsif card_product != blank and card_product.featured_image != blank
              assign card_image = card_product.featured_image
            else
              assign card_image = nil
            endif

            if block.settings.title != blank
              assign card_title = block.settings.title
            elsif card_product != blank
              assign card_title = card_product.title
            else
              assign card_title = 'Product title'
            endif

            if block.settings.link != blank
              assign card_link = block.settings.link
            elsif card_product != blank
              assign card_link = card_product.url
            else
              assign card_link = nil
            endif

            assign card_variant = card_product.selected_or_first_available_variant
            if card_variant != blank
              assign final_price = card_variant.price
              assign compare_price = card_variant.compare_at_price
            else
              assign final_price = card_product.price
              assign compare_price = card_product.compare_at_price
            endif
          %}

          <div class="cwc_featured-collection__card" {{ block.shopify_attributes }}>

            {% comment %} Image {% endcomment %}
            <div class="cwc_featured-collection__card-image">
              {% if card_link != blank %}<a href="{{ card_link }}" class="cwc_featured-collection__card-image-link">{% endif %}
                {% if card_image != blank %}
                  <img
                    class="cwc_featured-collection__card-img"
                    src="{{ card_image | image_url: width: 600 }}"
                    alt="{{ card_image.alt | default: card_title | escape }}"
                    loading="lazy"
                    width="413"
                    height="413"
                  >
                {% else %}
                  <div class="cwc_featured-collection__placeholder">
                    <span>Select a product</span>
                  </div>
                {% endif %}
              {% if card_link != blank %}</a>{% endif %}
            </div>

            {% comment %} Content {% endcomment %}
            <div class="cwc_featured-collection__card-content">

              {% if block.settings.rating > 0 or block.settings.review_count != blank %}
                <div class="cwc_featured-collection__card-reviews">
                  {% if block.settings.rating > 0 %}
                    <div class="cwc_featured-collection__stars">
                      {% for i in (1..block.settings.rating) %}{{ star_svg }}{% endfor %}
                    </div>
                  {% endif %}
                  {% if block.settings.review_count != blank %}
                    <span class="cwc_featured-collection__review-count">{{ block.settings.review_count }}</span>
                  {% endif %}
                </div>
              {% endif %}

              <div class="cwc_featured-collection__card-title">
                {% if card_link != blank %}
                  <a href="{{ card_link }}">{{ card_title }}</a>
                {% else %}
                  {{ card_title }}
                {% endif %}
              </div>

              {% if card_product != blank %}
                <div class="cwc_featured-collection__card-price">
                  {% if compare_price > final_price %}
                    <span class="cwc_featured-collection__price-compare">{{ compare_price | money }}</span>
                  {% endif %}
                  <span class="cwc_featured-collection__price-final">{{ final_price | money }}</span>
                  {% if compare_price > final_price %}
                    {% assign save_pct = compare_price | minus: final_price | times: 100 | divided_by: compare_price %}
                    <span class="cwc_featured-collection__badge-save">SAVE <strong>{{ save_pct }}%</strong></span>
                  {% endif %}
                </div>

                {% comment %} Native add-to-cart — triggers the theme cart drawer {% endcomment %}
                {% assign form_id = 'CWC-ProductForm-' | append: section.id | append: '-' | append: block.id %}
                <product-form-component
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ card_product.id }}"
                  on:submit="/handleSubmit"
                  class="cwc_featured-collection__form"
                >
                  <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                  {%- form 'product', card_product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                    <input
                      type="hidden"
                      name="id"
                      ref="variantId"
                      value="{{ card_variant.id }}"
                      {% if card_variant.available == false %}disabled{% endif %}
                    >
                    <input
                      type="hidden"
                      name="quantity"
                      value="{% if card_variant.quantity_rule.min %}{{ card_variant.quantity_rule.min }}{% else %}1{% endif %}"
                    >
                    {% render 'add-to-cart-button',
                      add_to_cart_text: 'Add to Cart',
                      class: 'cwc_featured-collection__atc',
                      can_add_to_cart: card_variant.available,
                      product: card_product
                    %}
                  {%- endform -%}
                </product-form-component>
              {% endif %}

            </div>
          </div>
        {% endfor %}
      </div>

      <button
        type="button"
        class="cwc_featured-collection__nav-btn cwc_featured-collection__nav-btn--next"
        data-cwc-next
        aria-label="Next"
      >
        <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M1 7.375L14.5 7.375M14.5 7.375L8.125 1M14.5 7.375L8.125 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

    </div>
  {% endif %}

</section>

<script src="{{ 'CWC_featured-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC Featured Collection",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Explore Pet Parent's <strong>Top Picks</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Join over 15,000+ happy owners upgrading their grooming routine.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1F3D6E"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "header",
      "content": "Card Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Image Background",
      "default": "#EAF6FF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "info": "Price, Add to Cart button, and carousel arrows.",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Save Badge Color",
      "default": "#E38A0A"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F7CD33"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Provides image, title, link, price, and Add to Cart."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to hide stars."
        },
        {
          "type": "text",
          "id": "review_count",
          "label": "Review Count",
          "default": "412 reviews"
        },
        {
          "type": "header",
          "content": "Overrides (Optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image Override"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title Override"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Override"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CWC Featured Collection",
      "category": "CWC Custom",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
