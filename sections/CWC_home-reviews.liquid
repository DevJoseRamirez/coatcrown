{% style %}
  #cwc_home-reviews-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ECF4FF' }};
    --text-color: {{ section.settings.text_color | default: '#333333' }};
    --heading-color: {{ section.settings.heading_color | default: '#1F3D6E' }};
    --highlight-color: {{ section.settings.bold_color | default: '#1F3D6E' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --star-color: {{ section.settings.star_color | default: '#FBBF24' }};
    --nav-bg: {{ section.settings.nav_color | default: '#1F3D6E' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_home-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    The chosen list's cards replace the blocks outright — the carousel shows one
    source or the other, never both. Blocks stay as the fallback so the section
    keeps working before the list has any cards on it.
  endcomment
  assign testimonial_list = section.settings.testimonial_list
  assign testimonial_cards = testimonial_list.list.value
  if testimonial_cards == blank
    assign testimonial_cards = testimonial_list.list
  endif

  assign use_metaobjects = false
  if testimonial_cards.size > 0
    assign use_metaobjects = true
  endif

  assign has_cards = false
  if use_metaobjects or section.blocks.size > 0
    assign has_cards = true
  endif
-%}

{%- capture star_svg -%}
  <svg class="cwc_home-reviews__star" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
  </svg>
{%- endcapture -%}

<section id="cwc_home-reviews-{{ section.id }}" class="cwc_home-reviews">
  <div class="cwc_home-reviews__container">
    {% comment %} Section Header {% endcomment %}
    <div class="cwc_home-reviews__content">
      {% if section.settings.top_rating_stars > 0 or section.settings.top_rating_text != blank %}
        <div class="cwc_home-reviews__top-rating">
          {% if section.settings.top_rating_stars > 0 %}
            <div class="cwc_home-reviews__top-stars">
              {% render 'CWC_stars__block' %}
            </div>
          {% endif %}
          {% if section.settings.top_rating_text != blank %}
            <div class="cwc_home-reviews__top-rating-text cwc-rte">{{ section.settings.top_rating_text }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_home-reviews__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_home-reviews__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Carousel {% endcomment %}
    {% if has_cards %}
      <div class="cwc_home-reviews__slider-wrapper">
        <button
          type="button"
          class="cwc_home-reviews__nav-btn cwc_home-reviews__nav-btn--prev"
          data-cwc-prev
          aria-label="Previous"
        >
          <svg
            width="17"
            height="18"
            viewBox="0 0 16 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M14.5 7.375L1 7.375M1 7.375L7.375 1M1 7.375L7.375 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <div class="cwc_home-reviews__track" data-cwc-track>
          {% if use_metaobjects %}
            {% for card in testimonial_cards %}
              {%- liquid
                assign card_text = card.text.value

                # Rating is a single line text field, so it has to be coerced
                # before it can be compared against a number.
                assign card_rating = card.rating.value | plus: 0
              -%}

              {% comment %}
                The card's Text field is plain multi-line text, so it is wrapped
                here — the card expects the same HTML the richtext blocks give it.
              {% endcomment %}
              {%- capture card_quote -%}
                {%- if card_text != blank -%}<p>{{ card_text | newline_to_br }}</p>{%- endif -%}
              {%- endcapture -%}

              {% render 'CWC_home-reviews-card__block',
                image: card.image.value,
                quote: card_quote,
                author_name: card.author.value,
                verified_text: section.settings.metaobject_verified_text,
                rating: card_rating
              %}
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'testimonial_card' %}
                  {% render 'CWC_home-reviews-card__block',
                    image: block.settings.review_image,
                    quote: block.settings.quote,
                    author_name: block.settings.author_name,
                    verified_text: block.settings.verified_text,
                    rating: block.settings.rating,
                    attributes: block.shopify_attributes
                  %}
              {% endcase %}
            {% endfor %}
          {% endif %}
        </div>

        <button
          type="button"
          class="cwc_home-reviews__nav-btn cwc_home-reviews__nav-btn--next"
          data-cwc-next
          aria-label="Next"
        >
          <svg
            width="17"
            height="18"
            viewBox="0 0 16 15"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M1 7.375L14.5 7.375M14.5 7.375L8.125 1M14.5 7.375L8.125 13.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<script src="{{ 'CWC_home-reviews.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
