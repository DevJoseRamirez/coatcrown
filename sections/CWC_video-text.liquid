<section id="cwc_video-text-{{ section.id }}" class="cwc_video-text">
  <div class="cwc_video-text__container">

    {% comment %} Videos {% endcomment %}
    <div class="cwc_video-text__videos">
      {% for slot in (1..2) %}
        {% if slot == 1 %}
          {% assign video = section.settings.video_left %}
        {% else %}
          {% assign video = section.settings.video_right %}
        {% endif %}
        <div class="cwc_video-text__video-inner">
          {% if video != blank %}
            <video class="cwc_video-text__video" preload="metadata" playsinline
              {% if video.preview_image != blank %}poster="{{ video.preview_image | image_url: width: 600 }}"{% endif %}>
              {% for source in video.sources %}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {% endfor %}
            </video>
            <button class="cwc_video-text__play-btn" type="button" aria-label="Play video">
              {{ play_svg }}
            </button>
          {% else %}
            <div class="cwc_video-text__placeholder"><span>Add video</span></div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% comment %} Content {% endcomment %}
    <div class="cwc_video-text__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_video-text__heading cwc-rte">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_video-text__subheading cwc-rte">{{ section.settings.subtext }}</div>
      {% endif %}

      {% assign has_stats = false %}
      {% for i in (1..3) %}
        {% assign txt_key = 'stat_' | append: i | append: '_text' %}
        {% if section.settings[txt_key] != blank %}{% assign has_stats = true %}{% endif %}
      {% endfor %}

      {% if has_stats %}
        <div class="cwc_video-text__stats">
          {% for i in (1..3) %}
            {% assign pct_key = 'stat_' | append: i | append: '_percent' %}
            {% assign txt_key = 'stat_' | append: i | append: '_text' %}
            {% assign stat_pct = section.settings[pct_key] %}
            {% assign stat_txt = section.settings[txt_key] %}
            {% if stat_txt != blank %}
              <div class="cwc_video-text__stat">
                <div class="cwc_video-text__circle" style="--percent: {{ stat_pct }}">
                  <span>{{ stat_pct }}%</span>
                </div>
                <div class="cwc_video-text__stat-text cwc-rte">{{ stat_txt }}</div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_video-text__button">
          <span>{{ section.settings.button_label }}</span>
          <svg class="cwc_video-text__button-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1 8L15 8M15 8L8.38889 1M15 8L8.38889 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      {% endif %}

      {% if section.settings.rating_stars > 0 or section.settings.rating_text != blank %}
        <div class="cwc_video-text__rating">
          {% if section.settings.rating_stars > 0 %}
            <div class="cwc_video-text__stars">
              {% for i in (1..section.settings.rating_stars) %}{{ star_svg }}{% endfor %}
            </div>
          {% endif %}
          {% if section.settings.rating_text != blank %}
            <div class="cwc_video-text__rating-text cwc-rte">{{ section.settings.rating_text }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<script src="{{ 'CWC_video-text.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
