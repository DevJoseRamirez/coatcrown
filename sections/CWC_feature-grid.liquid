{% style %}
  #cwc_feature-grid-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#142C70' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --icon-border-color: {{ section.settings.icon_border_color | default: '#E38A0A' }};
    --item-text-color: {{ section.settings.item_text_color | default: '#C77A1A' }};
    --button-bg: {{ section.settings.button_bg_color | default: '#E38A0A' }};
    --button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_feature-grid.css' | asset_url | stylesheet_tag }}

<section
  id="cwc_feature-grid-{{ section.id }}"
  class="cwc_feature-grid{% if section.settings.image_position == 'left' %} cwc_feature-grid--image-left{% endif %}"
>
  <div class="cwc_feature-grid__container">
    <div class="cwc_feature-grid__wrapper">

      {% comment %} Image {% endcomment %}
      <div class="cwc_feature-grid__media">
        {% if section.settings.image != blank %}
          <img
            class="cwc_feature-grid__image"
            src="{{ section.settings.image | image_url: width: 900 }}"
            alt="{{ section.settings.image.alt | default: 'Feature image' | escape }}"
            loading="lazy"
            width="900"
            height="675"
          >
        {% else %}
          <div class="cwc_feature-grid__placeholder">
            <span>Add image</span>
          </div>
        {% endif %}
      </div>

      {% comment %} Content {% endcomment %}
      <div class="cwc_feature-grid__content">
        {% if section.settings.heading != blank %}
          <div class="cwc_feature-grid__content-heading cwc-rte">
            {{ section.settings.heading }}
          </div>
        {% endif %}

        {% if section.settings.subtext != blank %}
          <div class="cwc_feature-grid__content-subtext cwc-rte">
            {{ section.settings.subtext }}
          </div>
        {% endif %}

        {% comment %} Feature Items {% endcomment %}
        {% if section.blocks.size > 0 %}
          <div class="cwc_feature-grid__grid">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'feature' %}
                  <div class="cwc_feature-grid__item" {{ block.shopify_attributes }}>
                    {% if block.settings.icon != blank %}
                      <div class="cwc_feature-grid__item-icon">
                        <img
                          src="{{ block.settings.icon | image_url: width: 48 }}"
                          alt="{{ block.settings.icon.alt | default: block.settings.title | escape }}"
                          loading="lazy"
                          width="24"
                          height="24"
                        >
                      </div>
                    {% endif %}

                    <div class="cwc_feature-grid__item-content">
                      {% if block.settings.title != blank %}
                        <p class="cwc_feature-grid__item-title">{{ block.settings.title }}</p>
                      {% endif %}

                      {% if block.settings.text != blank %}
                        <p class="cwc_feature-grid__item-text">{{ block.settings.text }}</p>
                      {% endif %}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        {% endif %}

        {% comment %} CTA Button {% endcomment %}
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_feature-grid__button">
            {{ section.settings.button_label }}
            <svg
              class="cwc_feature-grid__button-arrow"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path d="M1 8L15 8M15 8L8.38889 1M15 8L8.38889 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Feature Grid",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Engineered For <strong>Safety &amp; Hygiene</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Describe how this product is built and why it is safe to use.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "info": "Leave blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right",
      "info": "The image always stacks first on mobile."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Image"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon Border Color",
      "default": "#E38A0A"
    },
    {
      "type": "color",
      "id": "item_text_color",
      "label": "Item Description Color",
      "default": "#C77A1A"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#E38A0A"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Short supporting line"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CWC Feature Grid",
      "category": "CWC Custom",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
