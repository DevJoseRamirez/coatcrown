<section id="cwc_mission-{{ section.id }}" class="cwc_mission">
  <div class="cwc_mission__container">

    <div class="cwc_mission__image-col">
      {% if section.settings.mission_image != blank %}
        <img
          class="cwc_mission__image"
          src="{{ section.settings.mission_image | image_url: width: 800 }}"
          alt="{{ section.settings.alt_text | default: section.settings.mission_image.alt | default: 'Our mission' | escape }}"
          loading="lazy"
          width="800"
          height="800"
        >
      {% else %}
        <div class="cwc_mission__placeholder">
          <span>Add image</span>
        </div>
      {% endif %}
    </div>

    <div class="cwc_mission__content-col">
      {% if section.settings.heading != blank %}
        <div class="cwc_mission__title cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_mission__lead cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}

      {% if section.settings.body_text != blank %}
        <div class="cwc_mission__body cwc-rte">
          {{ section.settings.body_text }}
        </div>
      {% endif %}

      {% if section.settings.signature != blank %}
        <div class="cwc_mission__signature">{{ section.settings.signature }}</div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <div class="cwc_mission__button-wrapper">
          <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_mission__btn">
            <span>{{ section.settings.button_label }}</span>
            <svg class="cwc_mission__btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M1 8L15 8M15 8L8.38889 1M15 8L8.38889 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      {% endif %}

      {% if section.settings.rating_stars > 0 or section.settings.rating_text != blank %}
        <div class="cwc_mission__rating">
          {% if section.settings.rating_stars > 0 %}
            <div class="cwc_mission__stars">
              {% for i in (1..section.settings.rating_stars) %}{{ star_svg }}{% endfor %}
            </div>
          {% endif %}
          {% if section.settings.rating_text != blank %}
            <div class="cwc_mission__rating-text cwc-rte">{{ section.settings.rating_text }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "CWC Mission",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Our Mission, Led By <strong>Nora Mitchell</strong>, Founded With Love For Pets</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Lead Text",
      "default": "<p>At ReNu, our mission is simple: <strong>to make grooming calmer, kinder, and better for every pet.</strong> Founded by Nora, a passionate pet parent, ReNu was created to solve the daily struggles we all face — shedding, stress, and grooming battles that make bath time harder than it should be.</p>"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body Text",
      "default": "<p>With the help of trusted veterinary partners like Dr. Renu Ramesh, Nora turned this mission into a product that truly works: a grooming tool that relaxes pets, improves coat health, and strengthens the bond between you and your best friend.</p>"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Nora Mitchell ❤️"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Rating Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "<p><strong>4.8/5</strong> from <strong>45,000+</strong> of satisfied customers</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "mission_image",
      "label": "Mission Image",
      "info": "Displayed at a 1:1 ratio."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ECF4FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F7CD33"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#E69418"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "CWC Mission",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
