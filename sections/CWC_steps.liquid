<section id="cwc_steps-{{ section.id }}" class="cwc_steps">
  <div class="cwc_steps__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_steps__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_steps__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_steps__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} Steps {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_steps__grid">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'step_card' %}
              <div class="cwc_steps__item" {{ block.shopify_attributes }}>
                <div class="cwc_steps__image-wrapper">
                  {% if block.settings.step_image != blank %}
                    <img
                      class="cwc_steps__image"
                      src="{{ block.settings.step_image | image_url: width: 600 }}"
                      alt="{{ block.settings.step_image.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="cwc_steps__placeholder"><span>Add image</span></div>
                  {% endif %}
                  <div class="cwc_steps__number-badge">{{ forloop.index }}</div>
                </div>

                {% if block.settings.title != blank %}
                  <div class="cwc_steps__step-title">{{ block.settings.title }}</div>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="cwc_steps__step-desc cwc-rte">{{ block.settings.text }}</div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

    {% comment %} Footer: button + rating {% endcomment %}
    {% if section.settings.button_label != blank or section.settings.rating_stars > 0 or section.settings.rating_text != blank %}
      <div class="cwc_steps__footer">
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link | default: '#' }}" class="cwc_steps__btn">
            <span>{{ section.settings.button_label }}</span>
            <svg class="cwc_steps__btn-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M1 8L15 8M15 8L8.38889 1M15 8L8.38889 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.rating_stars > 0 or section.settings.rating_text != blank %}
          <div class="cwc_steps__rating">
            {% if section.settings.rating_stars > 0 %}
              <div class="cwc_steps__stars">
                {% for i in (1..section.settings.rating_stars) %}{{ star_svg }}{% endfor %}
              </div>
            {% endif %}
            {% if section.settings.rating_text != blank %}
              <div class="cwc_steps__rating-text cwc-rte">{{ section.settings.rating_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "CWC Steps",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>3 Easy Steps To A <strong>Fur-Free Home</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Experience the grooming transformation.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Rating Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "info": "Set to 0 to hide."
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "<p><strong>4.8/5</strong> from <strong>45,000+</strong> of satisfied customers</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Step Number Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#F7CD33"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button Background Color",
      "default": "#E69418"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step_card",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "step_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Describe this step in a sentence.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "CWC Steps",
      "category": "CWC Custom",
      "blocks": [
        {
          "type": "step_card",
          "settings": {
            "title": "Fill",
            "text": "<p>Add FreshFur Cleansing Mist and water to the brush reservoir.</p>"
          }
        },
        {
          "type": "step_card",
          "settings": {
            "title": "Mist & Brush",
            "text": "<p>Turn on the brush and release a gentle mist while brushing through your pet's coat.</p>"
          }
        },
        {
          "type": "step_card",
          "settings": {
            "title": "Instantly See Results",
            "text": "<p>Empty collected hair as needed. No rinsing required — towel dry if desired.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
