{% style %}
  #cwc_pdp-faq-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --caption-color: {{ section.settings.caption_color | default: '#B99A5B' }};
    --border-color: {{ section.settings.border_color | default: '#E3E3E3' }};
    --list-width: {{ section.settings.list_width | default: 640 }}px;
    --padding-top: {{ section.settings.padding_top | default: 80 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 80 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 80 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_pdp-faq.css' | asset_url | stylesheet_tag }}

<section id="cwc_pdp-faq-{{ section.id }}" class="cwc_pdp-faq">
  <div class="cwc_pdp-faq__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_pdp-faq__content">
      {% if section.settings.caption != blank %}
        <p class="cwc_pdp-faq__caption">{{ section.settings.caption }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="cwc_pdp-faq__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_pdp-faq__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} FAQ List {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_pdp-faq__list">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'faq_item' %}
              {% if block.settings.title != blank or block.settings.text != blank %}
                <div class="cwc_pdp-faq__item" {{ block.shopify_attributes }}>
                  <button
                    class="cwc_pdp-faq__question"
                    type="button"
                    aria-expanded="false"
                    data-cwc-faq-toggle
                  >
                    <span class="cwc_pdp-faq__question-text">{{ block.settings.title }}</span>
                    <span class="cwc_pdp-faq__icon" aria-hidden="true"></span>
                  </button>

                  {% if block.settings.text != blank %}
                    <div class="cwc_pdp-faq__answer cwc-rte">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% else %}
      <div class="cwc_pdp-faq__empty">
        <p>Add blocks to display content.</p>
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_pdp-faq.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC PDP FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "GOT QUESTIONS? WE HAVE ANSWERS!"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>FAQs</p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "list_width",
      "label": "List Max Width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "caption_color",
      "label": "Caption Color",
      "default": "#B99A5B"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider Color",
      "default": "#E3E3E3"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "How does the waterless bath work?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Add the answer to this question here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "CWC PDP FAQ",
      "category": "CWC Custom",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}
