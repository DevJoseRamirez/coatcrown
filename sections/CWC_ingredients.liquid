{% style %}
  #cwc_ingredients-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#111111' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --card-bg: {{ section.settings.card_bg_color | default: '#ffffff' }};
    --card-title-color: {{ section.settings.card_title_color | default: '#111111' }};
    --card-radius: {{ section.settings.card_radius | default: 10 }}px;
    --arrow-bg: {{ section.settings.arrow_bg_color | default: '#ffffff' }};
    --arrow-color: {{ section.settings.arrow_color | default: '#111111' }};
    --media-height: {{ section.settings.media_height | default: 520 }}px;
    --media-height-mobile: {{ section.settings.media_height | default: 520 | times: 0.55 }}px;
    --padding-top: {{ section.settings.padding_top | default: 60 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 60 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 0 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_ingredients.css' | asset_url | stylesheet_tag }}

<section id="cwc_ingredients-{{ section.id }}" class="cwc_ingredients">

  {% comment %} Section Header {% endcomment %}
  <div class="cwc_ingredients__container">
    <div class="cwc_ingredients__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_ingredients__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_ingredients__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>
  </div>

  {% comment %} Full-bleed slides — scroll-snap track, arrows only enhance {% endcomment %}
  {% if section.blocks.size > 0 %}
    <div class="cwc_ingredients__carousel">
      <div class="cwc_ingredients__track" data-cwc-track>
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'ingredient' %}
              <div class="cwc_ingredients__slide" {{ block.shopify_attributes }}>
                <div class="cwc_ingredients__media">
                  {% if block.settings.background_image != blank %}
                    <img
                      src="{{ block.settings.background_image | image_url: width: 2000 }}"
                      alt="{{ block.settings.background_image.alt | default: block.settings.title | escape }}"
                      loading="lazy"
                      width="2000"
                      height="1000"
                    >
                  {% else %}
                    <div class="cwc_ingredients__placeholder"><span>Add background image</span></div>
                  {% endif %}
                </div>

                {% if block.settings.title != blank or block.settings.text != blank %}
                  <div class="cwc_ingredients__card">
                    {% if block.settings.title != blank %}
                      <h3 class="cwc_ingredients__card-title">{{ block.settings.title }}</h3>
                    {% endif %}

                    {% if block.settings.text != blank %}
                      <div class="cwc_ingredients__card-text cwc-rte">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <button
          class="cwc_ingredients__arrow cwc_ingredients__arrow--prev"
          type="button"
          data-cwc-prev
          aria-label="Previous ingredient"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M10 2L4 8L10 14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>

        <button
          class="cwc_ingredients__arrow cwc_ingredients__arrow--next"
          type="button"
          data-cwc-next
          aria-label="Next ingredient"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 2L12 8L6 14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      {% endif %}
    </div>
  {% else %}
    <div class="cwc_ingredients__empty">
      <p>Add blocks to display content.</p>
    </div>
  {% endif %}

</section>

<script src="{{ 'CWC_ingredients.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC Ingredients",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Vet-Approved Ingredients for <strong>Waterless Wash</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "media_height",
      "label": "Slide Height",
      "min": 280,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Corner Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_title_color",
      "label": "Card Title Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow Icon Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Aloe Vera"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Helps soothe sensitive skin and keep the coat hydrated during waterless baths.</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CWC Ingredients",
      "category": "CWC Custom",
      "blocks": [
        { "type": "ingredient" },
        { "type": "ingredient" },
        { "type": "ingredient" }
      ]
    }
  ]
}
{% endschema %}
