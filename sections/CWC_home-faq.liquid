{% style %}
  #cwc_home-faq-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#111111' }};
    --heading-color: {{ section.settings.heading_color | default: '#142C70' }};
    --highlight-color: {{ section.settings.bold_color | default: '#142C70' }};
    --active-bg: {{ section.settings.active_bg_color | default: '#ECF4FF' }};
    --padding-top: {{ section.settings.padding_top | default: 100 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 100 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 100 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 100 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_home-faq.css' | asset_url | stylesheet_tag }}

<section id="cwc_home-faq-{{ section.id }}" class="cwc_home-faq">
  <div class="cwc_home-faq__container">

    {% comment %} Section Header {% endcomment %}
    <div class="cwc_home-faq__content">
      {% if section.settings.heading != blank %}
        <div class="cwc_home-faq__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="cwc_home-faq__content-subtext cwc-rte">
          {{ section.settings.subtext }}
        </div>
      {% endif %}
    </div>

    {% comment %} FAQ List {% endcomment %}
    {% if section.blocks.size > 0 %}
      <div class="cwc_home-faq__list">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'faq_item' %}
              {% if block.settings.title != blank or block.settings.text != blank %}
                <div class="cwc_home-faq__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                  <button
                    class="cwc_home-faq__question"
                    type="button"
                    aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  >
                    <span class="cwc_home-faq__question-text">{{ block.settings.title }}</span>
                    <span class="cwc_home-faq__icon" aria-hidden="true"></span>
                  </button>

                  {% if block.settings.text != blank %}
                    <div class="cwc_home-faq__answer">
                      <div class="cwc_home-faq__answer-inner cwc-rte">
                        {{ block.settings.text }}
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

  </div>
</section>

<script src="{{ 'CWC_home-faq.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "CWC Home FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Section Heading",
      "default": "<p>Frequently Asked <strong>Questions</strong></p>"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Section Subtext",
      "default": "<p>Need more information? You can find it here.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Answer Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & Question Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Heading Bold Color",
      "default": "#142C70"
    },
    {
      "type": "color",
      "id": "active_bg_color",
      "label": "Open Item Background",
      "default": "#ECF4FF"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Your question goes here?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Write the answer to this question here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CWC Home FAQ",
      "category": "CWC Custom",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "title": "Will this help with my pet's shedding or coat issues?",
            "text": "<p>Our grooming products are proudly crafted in Denver, Colorado, in a GMP-certified facility that adheres to the highest safety and quality standards.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "Is it safe to use on sensitive skin?",
            "text": "<p>FreshFur is designed to be gentle for everyday use. Most pets tolerate it well, but every pet is different. If your pet has known sensitivities, we recommend starting with a small area first and adjusting use based on your pet's comfort.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "How quickly will I see results?",
            "text": "<p>You'll notice results right away as you brush — loose fur, dirt, and debris lift away instantly. Results may vary depending on coat type and how dirty your pet is, but most customers see a difference during the first use.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "How do I use the brush and solution?",
            "text": "<p>Add FreshFur Cleansing Mist and water to the brush reservoir, turn on the brush and gently mist while brushing through the coat, then remove collected hair as needed — no rinsing required. Detailed instructions are included on the packaging.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "Do I need to use it every time I bathe my pet?",
            "text": "<p>No. FreshFur is designed for everyday cleanups between baths. It helps keep your pet fresh without the hassle of frequent bathing.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "title": "What if my pet doesn't like it at first?",
            "text": "<p>Many pets actually relax — and even fall asleep — while being brushed with FreshFur. The gentle misting combined with slow brushing helps create a calmer experience. As with anything new, start slowly and let your pet get comfortable over a few sessions.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
